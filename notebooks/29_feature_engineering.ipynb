    "---\n",
    "\n",
    "## 4. 去极值处理\n",
    "\n",
    "金融数据中常见极端值（单日涨跌停、乌龙指、数据错误），会严重影响均值和回归结果。\n",
    "\n",
    "### 4.1 三种去极值方法"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "def winsorize_series(s, lower=0.01, upper=0.99):\n",
    "    \"\"\"百分位数截尾（Winsorize）\"\"\"\n",
    "    lo, hi = s.quantile(lower), s.quantile(upper)\n",
    "    return s.clip(lo, hi)\n",
    "\n",
    "def zscore_clip(s, threshold=3):\n",
    "    \"\"\"Z-score 去极值\"\"\"\n",
    "    mu, sigma = s.mean(), s.std()\n",
    "    return s.clip(mu - threshold * sigma, mu + threshold * sigma)\n",
    "\n",
    "def mad_clip(s, threshold=3):\n",
    "    \"\"\"MAD (中位数绝对偏差) 去极值\"\"\"\n",
    "    med = s.median()\n",
    "    mad = (s - med).abs().median()\n",
    "    return s.clip(med - threshold * mad, med + threshold * mad)\n",
    "\n",
    "# 用收益数据测试三种方法\n",
    "ret_sample = price_filled.pct_change().iloc[:, 0].dropna()\n",
    "\n",
    "print(f'原始收益统计:')\n",
    "print(f'  均值: {ret_sample.mean():.6f}  标准差: {ret_sample.std():.6f}')\n",
    "print(f'  最小值: {ret_sample.min():.6f}  最大值: {ret_sample.max():.6f}')\n",
    "print(f'  偏度: {ret_sample.skew():.3f}  峰度: {ret_sample.kurtosis():.3f}')\n",
    "\n",
    "print(f'\\n===== 三种去极值方法对比 =====')\n",
    "for name, func in [('Winsorize(1%,99%)', lambda x: winsorize_series(x)),\n",
    "                    ('Z-score(3σ)', lambda x: zscore_clip(x)),\n",
    "                    ('MAD(3×MAD)', lambda x: mad_clip(x))]:\n",
    "    cleaned = func(ret_sample)\n",
    "    print(f'\\n{name}:')\n",
    "    print(f'  范围: [{cleaned.min():.4f}, {cleaned.max():.4f}]')\n",
    "    print(f'  标准差变化: {ret_sample.std():.6f} → {cleaned.std():.6f}')\n",
    "    print(f'  极值改变数: {(ret_sample != cleaned).sum()} 个')"
   ],
