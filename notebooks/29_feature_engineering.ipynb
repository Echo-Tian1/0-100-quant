    "y = forward_ret.loc[common_idx]\n",
    "\n",
    "print(f'特征: {target_factor}')\n",
    "print(f'样本数: {len(X)}')\n",
    "print(f'日期: {common_idx[0].date()} ~ {common_idx[-1].date()}')"
