    "series_missing = test_series.copy()\n",
    "series_missing.iloc[missing_idx] = np.nan\n",
    "\n",
    "print(f'原始数据: {len(test_series)}个观测')\n",
    "print(f'人工缺失: {len(missing_idx)}个 ({len(missing_idx)/n:.1%})')"
   ],
