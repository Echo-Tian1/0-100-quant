    "X_train, X_test = X_scaled[:split], X_scaled[split:]\n",
    "\n",
    "# ✅ 正确：只在训练集上 fit\n",
    "scaler = StandardScaler()\n",
    "X_train = scaler.fit_transform(X[:split])\n",
    "X_test = scaler.transform(X[split:])\n",
    "```\n",
