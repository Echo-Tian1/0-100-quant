    "print(f'  处理前缺失: {missing_before:,}')\n",
    "print(f'  处理后缺失: {missing_after}')\n",
    "print(f'  处理率:     {(missing_before - missing_after) / max(missing_before, 1):.1%}')\n",
    "\n",
    "# 对成交量做同样处理\n",
    "volume_filled = volume_raw.ffill().bfill()\n",
    "\n",
