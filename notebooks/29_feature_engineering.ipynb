    "---\n",
    "\n",
    "## 6. 特征构造：构建 50+ 因子\n",
    "\n",
    "### 6.1 因子分类\n",
    "\n",
    "基于原始价格和成交量数据，构造以下因子类别：\n",
    "\n",
    "| 类别 | 数量 | 示例 |\n",
    "|------|------|------|\n",
    "| 动量因子 | ~12 | 过去N日收益、夏普比 |\n",
    "| 波动率因子 | ~8 | 历史波动率、上行/下行波动率 |\n",
    "| 成交量因子 | ~8 | 量比、换手率变化、VWAP偏离 |\n",
    "| 技术指标因子 | ~12 | RSI、MACD、布林带 |\n",
    "| 价格形态因子 | ~6 | 距N日均线偏离、新高/新低 |\n",
    "| 横截面因子 | ~6 | 行业相对强度、横截面排名 |\n",
    "\n",
    "**合计：约 52 个因子**"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "def construct_factors(price_df, volume_df, turn_df=None):\n",
    "    \"\"\"\n",
    "    从价格和成交量数据构造 50+ 因子。\n",
    "    \n",
    "    参数:\n",
    "        price_df: 价格 DataFrame (日期 × 股票)\n",
    "        volume_df: 成交量 DataFrame\n",
    "        turn_df: 换手率 DataFrame (可选)\n",
    "    \n",
    "    返回:\n",
    "        factors: 多级列索引 DataFrame (因子类别, 因子名, 股票)\n",
    "    \"\"\"\n",
    "    ret = price_df.pct_change()\n",
    "    log_ret = np.log(price_df / price_df.shift(1))\n",
    "    factors = {}\n",
    "    \n",
    "    # ---- 1. 动量因子 (12个) ----\n",
    "    windows = [5, 10, 20, 60, 120, 250]\n",
    "    for w in windows:\n",
    "        if len(price_df) > w:\n",
    "            factors[f'mom_{w}d'] = price_df.pct_change(w)\n",
    "        if w <= 120:\n",
    "            factors[f'mom_skip1_{w}d'] = price_df.shift(1).pct_change(w)\n",
    "    \n",
    "    # 夏普比\n",
    "    for w in [20, 60, 120]:\n",
    "        roll_ret = ret.rolling(w).mean()\n",
    "        roll_vol = ret.rolling(w).std()\n",
    "        factors[f'sharpe_{w}d'] = roll_ret / roll_vol * np.sqrt(252)\n",
    "    \n",
    "    # ---- 2. 波动率因子 (8个) ----\n",
    "    for w in [5, 10, 20, 60, 120]:\n",
    "        factors[f'vol_{w}d'] = ret.rolling(w).std()\n",
    "    \n",
    "    # 上行/下行波动率\n",
    "    for w in [20, 60]:\n",
    "        up_ret = ret.clip(lower=0)\n",
    "        down_ret = ret.clip(upper=0)\n",
    "        factors[f'upvol_{w}d'] = up_ret.rolling(w).std()\n",
    "        factors[f'downvol_{w}d'] = down_ret.rolling(w).std()\n",
    "    \n",
    "    # 下行标准差占比\n",
    "    for w in [20, 60]:\n",
    "        factors[f'down_ratio_{w}d'] = down_ret.rolling(w).std() / ret.rolling(w).std()\n",
    "    \n",
    "    # ---- 3. 成交量因子 (8个) ----\n",
    "    vol_ma5 = volume_df.rolling(5).mean()\n",
    "    vol_ma20 = volume_df.rolling(20).mean()\n",
    "    factors['vol_ratio_5d'] = volume_df / vol_ma5\n",
    "    factors['vol_ratio_20d'] = volume_df / vol_ma20\n",
    "    factors['vol_change_5d'] = volume_df.pct_change(5)\n",
    "    factors['vol_change_20d'] = volume_df.pct_change(20)\n",
    "    \n",
    "    # 量价相关\n",
    "    factors['vol_price_corr_20d'] = ret.rolling(20).corr(volume_df.pct_change())\n",
    "    \n",
    "    # 换手率相关（如果有）\n",
    "    if turn_df is not None and not turn_df.empty:\n",
    "        factors['turn_5d'] = turn_df.rolling(5).mean()\n",
    "        factors['turn_20d'] = turn_df.rolling(20).mean()\n",
    "        factors['turn_change_20d'] = turn_df.pct_change(20)\n",
    "    else:\n",
    "        # 用成交量作为换手率代理\n",
    "        factors['turn_proxy_5d'] = volume_df.rolling(5).mean()\n",
    "        factors['turn_proxy_20d'] = volume_df.rolling(20).mean()\n",
    "        factors['turn_proxy_change_20d'] = volume_df.pct_change(20)\n",
    "    \n",
    "    # ---- 4. 技术指标因子 (12个) ----\n",
    "    # RSI\n",
    "    delta = price_df.diff()\n",
    "    for w in [6, 14, 28]:\n",
    "        gain = delta.clip(lower=0).rolling(w).mean()\n",
    "        loss = -delta.clip(upper=0).rolling(w).mean()\n",
    "        rs = gain / (loss + 1e-10)\n",
    "        factors[f'rsi_{w}d'] = 100 - (100 / (1 + rs))\n",
    "    \n",
    "    # MACD\n",
    "    for stock in price_df.columns:\n",
    "        ema12 = price_df[stock].ewm(span=12, adjust=False).mean()\n",
    "        ema26 = price_df[stock].ewm(span=26, adjust=False).mean()\n",
    "        if f'macd' not in factors:\n",
    "            factors[f'macd'] = pd.DataFrame(index=price_df.index, columns=price_df.columns)\n",
    "            factors[f'macd_signal'] = pd.DataFrame(index=price_df.index, columns=price_df.columns)\n",
    "            factors[f'macd_hist'] = pd.DataFrame(index=price_df.index, columns=price_df.columns)\n",
    "        macd_line = ema12 - ema26\n",
    "        signal = macd_line.ewm(span=9, adjust=False).mean()\n",
    "        factors[f'macd'][stock] = macd_line\n",
    "        factors[f'macd_signal'][stock] = signal\n",
    "        factors[f'macd_hist'][stock] = macd_line - signal\n",
    "    \n",
    "    # 布林带\n",
    "    for w in [20]:\n",
    "        ma = price_df.rolling(w).mean()\n",
    "        std = price_df.rolling(w).std()\n",
    "        factors[f'bb_position_{w}d'] = (price_df - ma) / (2 * std + 1e-10)\n",
    "        factors[f'bb_width_{w}d'] = (2 * std) / ma\n",
    "    \n",
    "    # ---- 5. 价格形态因子 (6个) ----\n",
    "    for w in [5, 20, 60]:\n",
    "        ma = price_df.rolling(w).mean()\n",
    "        factors[f'ma_dev_{w}d'] = price_df / ma - 1\n",
    "    \n",
    "    # 新高/新低\n",
    "    for w in [20, 60, 120]:\n",
    "        rolling_max = price_df.rolling(w).max()\n",
    "        factors[f'high_proximity_{w}d'] = price_df / rolling_max - 1\n",
    "    \n",
    "    # ---- 6. 偏度/峰度因子 (4个) ----\n",
    "    for w in [20, 60]:\n",
    "        factors[f'skew_{w}d'] = ret.rolling(w).skew()\n",
    "        factors[f'kurt_{w}d'] = ret.rolling(w).kurt()\n",
    "    \n",
    "    # ---- 7. 路径因子 (4个) ----\n",
    "    # 最大回撤\n",
    "    for w in [20, 60]:\n",
    "        cum_max = price_df.rolling(w).max()\n",
    "        factors[f'maxdd_{w}d'] = price_df / cum_max - 1\n",
    "    \n",
    "    # 收益波动比（信息比率代理）\n",
    "    for w in [20, 60]:\n",
    "        roll_ret = ret.rolling(w).mean()\n",
    "        roll_vol = ret.rolling(w).std()\n",
    "        factors[f'ret_vol_ratio_{w}d'] = roll_ret / (roll_vol + 1e-10)\n",
    "    \n",
    "    # ---- 8. 横截面排名因子 (4个) ----\n",
    "    # 每日对各因子做横截面排名\n",
    "    for key in ['mom_20d', 'vol_20d']:\n",
    "        if key in factors:\n",
    "            factors[f'{key}_rank'] = factors[key].rank(axis=1, pct=True)\n",
    "    \n",
    "    # ---- 合并所有因子 ----\n",
    "    # 用 MultiIndex\n",
    "    all_factors = {}\n",
    "    for name, df in factors.items():\n",
    "        all_factors[name] = df\n",
    "    \n",
    "    factor_df = pd.concat(all_factors, axis=1)\n",
    "    factor_df.columns.names = ['factor_name', 'stock']\n",
    "    \n",
    "    # 删除全为 NaN 的行\n",
    "    factor_df = factor_df.dropna(how='all')\n",
    "    \n",
    "    return factor_df\n",
    "\n",
    "print('🔄 构造因子 (可能需要几十秒)...')\n",
    "factor_df = construct_factors(price_filled, volume_filled, turn_raw)\n",
    "print(f'\\n✅ 因子构造完毕')\n",
    "print(f'数据形状: {factor_df.shape[0]}天 × {factor_df.shape[1]}个(因子×股票)')"
   ],
   "outputs": [],
   "execution_count": null
  },
  {
