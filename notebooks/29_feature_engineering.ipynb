  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "from sklearn.pipeline import Pipeline\n",
    "from sklearn.preprocessing import FunctionTransformer\n",
    "\n",
    "def build_feature_pipeline(missing_strategy='ffill', winsorize_pct=(0.01, 0.99), scaler='robust'):\n",
    "    \"\"\"\n",
    "    构建完整的特征工程 Pipeline。\n",
    "    \n",
    "    参数:\n",
    "        missing_strategy: 缺失值策略 ('ffill', 'mean', 'drop')\n",
    "        winsorize_pct: 去极值上下分位数\n",
    "        scaler: 标准化方法 ('standard', 'minmax', 'robust')\n",
    "    \n",
    "    返回:\n",
    "        pipeline: sklearn Pipeline 对象\n",
    "    \"\"\"\n",
    "    steps = []\n",
    "    \n",
    "    # 步骤1: 缺失值处理\n",
    "    if missing_strategy == 'ffill':\n",
    "        steps.append(('imputer', FunctionTransformer(\n",
    "            lambda X: pd.DataFrame(X).ffill().bfill().values, validate=False)))\n",
    "    elif missing_strategy == 'mean':\n",
    "        steps.append(('imputer', SimpleImputer(strategy='mean')))\n",
    "    \n",
    "    # 步骤2: 去极值\n",
    "    lower, upper = winsorize_pct\n",
    "    steps.append(('winsorize', FunctionTransformer(\n",
    "        lambda X: np.clip(X, np.nanpercentile(X, lower*100, axis=0),\n",
    "                          np.nanpercentile(X, upper*100, axis=0)), validate=False)))\n",
    "    \n",
    "    # 步骤3: 标准化\n",
    "    if scaler == 'standard':\n",
    "        steps.append(('scaler', StandardScaler()))\n",
    "    elif scaler == 'minmax':\n",
    "        steps.append(('scaler', MinMaxScaler()))\n",
    "    else:\n",
    "        steps.append(('scaler', RobustScaler()))\n",
    "    \n",
    "    return Pipeline(steps)\n",
    "\n",
    "# 测试 Pipeline\n",
    "pipeline = build_feature_pipeline(missing_strategy='ffill', scaler='robust')\n",
    "\n",
    "print('Pipeline 结构:')\n",
    "for name, step in pipeline.steps:\n",
    "    print(f'  {name}: {step.__class__.__name__}')\n",
    "\n",
    "# 应用到示例数据\n",
    "X_sample = factor_df.iloc[:, :10].values  # 取前10个(因子×股票)\n",
    "X_processed = pipeline.fit_transform(X_sample)\n",
    "\n",
    "print(f'\\n处理前: shape={X_sample.shape}')\n",
    "print(f'  均值: {np.nanmean(X_sample):.4f}  标准差: {np.nanstd(X_sample):.4f}')\n",
    "print(f'  最小值: {np.nanmin(X_sample):.4f}  最大值: {np.nanmax(X_sample):.4f}')\n",
    "\n",
    "print(f'\\n处理后: shape={X_processed.shape}')\n",
    "print(f'  均值: {np.nanmean(X_processed):.4f}  标准差: {np.nanstd(X_processed):.4f}')\n",
    "print(f'  最小值: {np.nanmin(X_processed):.4f}  最大值: {np.nanmax(X_processed):.4f}')\n",
    "print(f'  缺失值: {np.isnan(X_processed).sum()}')\n",
    "\n",
    "print(f'\\n✅ Pipeline 测试通过')"
   ],
