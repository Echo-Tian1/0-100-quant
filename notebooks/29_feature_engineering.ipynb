   "cell_type": "code",
   "metadata": {},
   "source": [
    "# ===== 策略2：均值填充 =====\n",
    "strategy2 = series_missing.fillna(series_missing.mean())\n",
    "print(f'策略2 均值填充: 填充 {series_missing.isnull().sum()} 个缺失')\n",
    "print(f'  → 均值偏差: {strategy2.mean() - test_series.mean():.6f}')\n",
    "print(f'  → 标准差偏差: {strategy2.std() - test_series.std():.6f} (⚠️ 低估波动率)')"
   ],
   "outputs": [],
   "execution_count": null
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# ===== 策略3：中位数填充 =====\n",
    "strategy3 = series_missing.fillna(series_missing.median())\n",
    "print(f'策略3 中位数填充:')\n",
    "print(f'  → 均值偏差: {strategy3.mean() - test_series.mean():.6f}')\n",
    "print(f'  → 标准差偏差: {strategy3.std() - test_series.std():.6f}')"
   ],
   "outputs": [],
   "execution_count": null
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# ===== 策略4：前向填充 (Forward Fill) =====\n",
    "strategy4 = series_missing.ffill()\n",
    "print(f'策略4 前向填充(ffill): 用上一个有效值填充')\n",
    "print(f'  → 均值偏差: {strategy4.mean() - test_series.mean():.6f}')\n",
    "print(f'  → 标准差偏差: {strategy4.std() - test_series.std():.6f}')\n",
    "print(f'  ⚠️ 注意：连续的缺失值会导致同一值重复填充，可能引入自相关')"
   ],
   "outputs": [],
   "execution_count": null
  },
