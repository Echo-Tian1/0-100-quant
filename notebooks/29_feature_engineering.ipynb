  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# ===== 策略1：直接删除 =====\n",
    "strategy1 = series_missing.dropna()\n",
    "print(f'策略1 直接删除: 剩余 {len(strategy1)} 个观测 (损失 {len(missing_idx)} 个)')\n",
